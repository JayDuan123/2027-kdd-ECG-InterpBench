# Repository parent containing the six model codebases and local checkpoints.
ECG_INTERPBENCH_WORKSPACE=/path/to/ecg-workspace

# Dataset parent. Defaults to ${ECG_INTERPBENCH_WORKSPACE}/data.
ECG_INTERPBENCH_DATA_ROOT=/path/to/ecg-data

# Optional dataset-specific overrides.
PTBXL_ROOT=/path/to/ptb-xl
PTBXL_PLUS_ROOT=/path/to/ptb-xl-plus

# Local result root used by analysis and Slurm wrappers.
ECG_INTERPBENCH_RESULTS=/path/to/results
